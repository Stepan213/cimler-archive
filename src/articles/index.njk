---
layout: base.njk
title: Articles
permalink: /articles/
eleventyExcludeFromCollections: true
tags: []
---
<header class="page-head">
  <h1>Articles</h1>
  <p class="lede">Stories, notes and other writing.</p>
</header>
<ol class="post-list">
{%- for post in collections.articles | reverse %}
  <li>
    <a href="{{ post.url }}">
      <time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate(post.data.lang) }}</time>
      <h2>{{ post.data.title }}</h2>
      {%- if post.data.description %}<p>{{ post.data.description }}</p>{% endif %}
    </a>
  </li>
{%- else %}
  <li>Nothing here yet.</li>
{%- endfor %}
</ol>

---
layout: base.njk
---
<article class="post">
  <header class="post-head">
    <p class="meta">
      <time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate(lang) }}</time>
      <span aria-hidden="true">·</span> {{ content | readingTime(lang) }}
    </p>
    <h1>{{ title }}</h1>
  </header>
  <div class="prose">
{{ content | safe }}
  </div>
</article>
<p class="back"><a href="/articles/">← {% if lang == "cs" %}Všechny články{% else %}All articles{% endif %}</a></p>
